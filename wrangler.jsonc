{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aelios-resident",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Values you change in the Dashboard survive the next deploy.
  "keep_vars": true,
  // Workers AI, plus AI Gateway for vendor models such as anthropic/claude-* and for web search.
  "ai": { "binding": "AI" },
  // Cloudflare's headless Chrome, for pages web_fetch can only read once their JavaScript has run.
  // Workers Paid includes 10 browser hours a month; without this binding those pages come back nearly empty.
  "browser": { "binding": "BROWSER" },
  // Cloudflare Images, to scale the photos she sends down to what the model reads (pictures.ts). Its free
  // allowance is 5,000 pictures a month; when it is not available the photos go as they are.
  "images": { "binding": "IMAGES" },
  // The web door (public/index.html). Everything else goes to the Worker first.
  "assets": {
    "directory": "public",
    "run_worker_first": ["/messengers/*", "/tg/*", "/web/*", "/mcp/*", "/stickers/*", "/tasks/*", "/desktop/*", "/avatar/*", "/r/*", "/manifest.webmanifest"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RESIDENT", "class_name": "Resident" }
    ]
  },
  // SQLite-backed Durable Objects are the kind the Workers Free plan allows. ClaudeBox (v2) is left from when the
  // Claude box ran in a Cloudflare container; it holds nothing.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Resident"] },
    { "tag": "v2", "new_sqlite_classes": ["ClaudeBox"] }
  ],
  "observability": { "enabled": true }
  // No "vars" here on purpose: a value written in this file would overwrite what you set in the
  // Dashboard on every push. Every setting has a default in the code; set the ones you need in
  // Dashboard → Worker → Settings → Variables and Secrets (type Text). See README for the list:
  //   AI_GATEWAY_ID, TG_BOT_USERNAME, TG_ALLOWED, TIME_ZONE, DEBOUNCE_SECONDS,
  //   LETTER_TOKEN_THRESHOLD, LETTER_IDLE_MINUTES, CACHE_TTL, AELIOS_URL, AELIOS_NAMESPACE,
  //   WEB_SEARCH, WEB_FETCH, WEB_FETCH_MODEL, CHECKIN_SCHEDULE
  // Secrets (Dashboard → Worker → Settings → Variables and Secrets, type Secret):
  //   TG_BOT_TOKEN         from @BotFather
  //   TG_WEBHOOK_SECRET    any long random string you make up (letters, digits, _ and -)
  //   AELIOS_API_KEY       the value of your Aelios' CHATBOX_API_KEY, IM_API_KEY or MEMORY_MCP_API_KEY
  //                        (all read and write the "default" space; only CHATBOX_API_KEY lets AELIOS_NAMESPACE pick another)
  //   WEB_KEY              the password for the web door; unset = the web door stays shut
  //   TAVILY_API_KEY, BRAVE_API_KEY, PERPLEXITY_API_KEY   your own search keys, tried in that order
  // The model and the persona are not secrets or vars: pick them on the web door.
}
