// Local test config: no AI binding, scripted "fake" model, Telegram and Aelios mocked on :9999.
{
  "name": "aelios-resident-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "run_worker_first": ["/messengers/*", "/tg/*", "/web/*", "/mcp/*", "/stickers/*", "/tasks/*", "/avatar/*", "/r/*", "/manifest.webmanifest"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RESIDENT", "class_name": "Resident" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Resident"] },
    { "tag": "v2", "new_sqlite_classes": ["ClaudeBox"] }
  ],
  "vars": {
    "FAKE_MODEL": "true",
    "TG_BOT_USERNAME": "resident_test_bot",
    "TG_ALLOWED": "@her_test",
    "TIME_ZONE": "Asia/Shanghai",
    "DEBOUNCE_SECONDS": "1",
    "LETTER_IDLE_MINUTES": "off",
    // Tests run at any hour of the day: no quiet hours unless a test sets them.
    "QUIET_HOURS": "off",
    "AELIOS_URL": "http://127.0.0.1:9999",
    "AELIOS_NAMESPACE": "test-space",
    "WEB_SEARCH": "off",
    "CHECKIN_SCHEDULE": "",
    "TG_API_BASE": "http://127.0.0.1:9999",
    "TG_BOT_TOKEN": "123456:test-token",
    "TG_WEBHOOK_SECRET": "test-secret",
    "AELIOS_API_KEY": "test-key",
    "WEB_KEY": "test-web-key",
    "CUSTOM_BASE_URL": "http://127.0.0.1:9999/custom/v1",
    "CUSTOM_API_KEY": "test-custom-key",
    "CLOUD_TASK_API_BASE": "http://127.0.0.1:9999",
    // The fake Claude box in mock-server.mjs, for the claude-code/… models.
    "CLAUDE_BOX_URL": "http://127.0.0.1:9999/claude-box",
    "CLAUDE_CODE_OAUTH_TOKEN": "sk-ant-oat01-test-token-for-the-fake-box"
  }
}
